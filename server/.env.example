# Every NEXUS_* variable the server reads. Values below are placeholders.
# R2
NEXUS_DB_URL=postgresql+psycopg://nexus:CHANGE_ME@localhost:5432/nexus
# Dedicated test database; its name must contain "test" or the DB tests are skipped.
NEXUS_TEST_DB_URL=postgresql+psycopg://nexus:CHANGE_ME@localhost:5432/nexus_test
# Optional: DEBUG, INFO (default), WARNING
NEXUS_LOG_LEVEL=INFO
# R3
# Bearer token for the dashboard (one per deployment). Unset = no dashboard access.
NEXUS_DASHBOARD_TOKEN=CHANGE_ME
