# Bash: source this file with `set -a` to export the settings.
NEXUS_ENDPOINT_ID=linux-vm-01
NEXUS_TETRAGON_LOG=/var/log/tetragon/tetragon.log

# Use http://127.0.0.1:8000/api/v1 for the local mock.
NEXUS_SERVER_URL=https://nexus-server:8443/api/v1
# Optionally set the path to the lab CA PEM file.
NEXUS_CA_FILE=
# Set the bearer token in your shell without putting it in the command line.
NEXUS_TOKEN=
