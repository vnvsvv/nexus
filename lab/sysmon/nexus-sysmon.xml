<!--
  NEXUS Sysmon configuration - LAB VM profile (windows-vm-01 only; Sysmon 15.x, config schema 4.91)
  DO NOT INSTALL THIS ON A PERSONAL LAPTOP. It logs every process creation, every process exit,
  most network connections and all DNS queries. Use lab/sysmon/nexus-sysmon-dev.xml on a laptop.

  STATUS: UNVALIDATED. This file was written without access to a real Windows installation and has
  never been loaded by a real Sysmon. Verify it on the lab VM with the matrix in lab/sysmon/README.md.
  When it has been verified, replace the word UNVALIDATED in this comment with VALIDATED YYYY-MM-DD
  (tools/lint_sysmon_config.py requires exactly one of the two) and record the date in STATUS.md.

  Install: Sysmon64.exe -accepteula -i C:\ProgramData\nexus\nexus-sysmon.xml
  Update:  Sysmon64.exe -c C:\ProgramData\nexus\nexus-sysmon.xml
  (The config is copied outside C:\Lab so that installing it does not create lab-folder events.)
  Verify:  Get-WinEvent -LogName "Microsoft-Windows-Sysmon/Operational" -MaxEvents 5

  EVENTS USED BY NEXUS: 1, 3, 5, 11, 22, 26. EID 23 is off (it archives deleted files into C:\Sysmon).
  EID 26 records that a lab file was deleted and does not keep a copy. No NEXUS rule uses deletes yet;
  the events exist for evidence and for the telemetry coverage table in the report.

  SELF-TRAFFIC: the agent talks to the gateway (192.168.20.1, or 192.168.10.1 if nexus-server resolves
  through dnsmasq). All connections to those addresses are excluded so the agent does not observe
  itself. NX-WIN-001 already ignores 192.168.20.1 for the same reason. Consequence: scenarios must not
  target the gateway itself; they target linux-vm-01 (192.168.10.10).

  CONVENTIONS: ASCII only, no double hyphen inside comments, every RuleGroup sets groupRelation
  explicitly. "or" means a single matching rule is enough.
-->
<Sysmon schemaversion="4.91">
  <HashAlgorithms>SHA256</HashAlgorithms>
  <CheckRevocation>False</CheckRevocation>
  <DnsLookup>False</DnsLookup>
  <EventFiltering>

    <!-- EID 1: log everything except the loudest system noise -->
    <RuleGroup name="ProcessCreate" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <Image condition="is">C:\Windows\System32\conhost.exe</Image>
        <Image condition="is">C:\Windows\System32\SearchFilterHost.exe</Image>
        <Image condition="is">C:\Windows\System32\SearchProtocolHost.exe</Image>
        <Image condition="begin with">C:\Windows\System32\wbem\WmiPrvSE.exe</Image>
        <ParentImage condition="is">C:\Windows\System32\svchost.exe</ParentImage>
      </ProcessCreate>
    </RuleGroup>

    <!-- EID 3: everything except loopback, link-local, svchost, and traffic to the gateway itself -->
    <RuleGroup name="NetworkConnect" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <DestinationIp condition="begin with">127.</DestinationIp>
        <DestinationIp condition="is">::1</DestinationIp>
        <DestinationIp condition="is">0:0:0:0:0:0:0:1</DestinationIp>
        <DestinationIp condition="begin with">fe80:</DestinationIp>
        <DestinationIp condition="is">192.168.20.1</DestinationIp>
        <DestinationIp condition="is">192.168.10.1</DestinationIp>
        <Image condition="is">C:\Windows\System32\svchost.exe</Image>
      </NetworkConnect>
    </RuleGroup>

    <!-- EID 5: log all terminations (no rules means nothing is excluded) -->
    <RuleGroup name="ProcessTerminate" groupRelation="or">
      <ProcessTerminate onmatch="exclude" />
    </RuleGroup>

    <!-- EID 11: lab paths and common staging locations; manifests are ground truth, not evidence -->
    <RuleGroup name="FileCreate" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="begin with">C:\Lab\</TargetFilename>
        <TargetFilename condition="begin with">C:\Users\Public\</TargetFilename>
        <TargetFilename condition="contains">\AppData\Local\Temp\</TargetFilename>
        <TargetFilename condition="end with">.ps1</TargetFilename>
        <TargetFilename condition="end with">.exe</TargetFilename>
      </FileCreate>
      <FileCreate onmatch="exclude">
        <TargetFilename condition="begin with">C:\Lab\manifests\</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- EID 22: all DNS queries except reverse lookups, the agent's server name and Windows service noise -->
    <RuleGroup name="DnsQuery" groupRelation="or">
      <DnsQuery onmatch="exclude">
        <QueryName condition="end with">.in-addr.arpa</QueryName>
        <QueryName condition="begin with">nexus-server</QueryName>
        <QueryName condition="end with">.microsoft.com</QueryName>
        <QueryName condition="end with">.windowsupdate.com</QueryName>
        <QueryName condition="end with">.windows.com</QueryName>
        <QueryName condition="end with">.msftconnecttest.com</QueryName>
      </DnsQuery>
    </RuleGroup>

    <!-- EID 26: delete detected under the lab folder, not archived -->
    <RuleGroup name="FileDeleteDetected" groupRelation="or">
      <FileDeleteDetected onmatch="include">
        <TargetFilename condition="begin with">C:\Lab\</TargetFilename>
      </FileDeleteDetected>
    </RuleGroup>

    <!-- EID 23 is OFF on purpose: it saves a copy of every matching deleted file under C:\Sysmon -->
    <RuleGroup name="FileDelete" groupRelation="or">
      <FileDelete onmatch="include" />
    </RuleGroup>

    <!-- Everything else is OFF: an include filter without rules logs nothing -->
    <RuleGroup name="Off" groupRelation="or">
      <FileCreateTime onmatch="include" />
      <DriverLoad onmatch="include" />
      <ImageLoad onmatch="include" />
      <CreateRemoteThread onmatch="include" />
      <RawAccessRead onmatch="include" />
      <ProcessAccess onmatch="include" />
      <RegistryEvent onmatch="include" />
      <FileCreateStreamHash onmatch="include" />
      <PipeEvent onmatch="include" />
      <WmiEvent onmatch="include" />
      <ClipboardChange onmatch="include" />
      <ProcessTampering onmatch="include" />
      <FileExecutableDetected onmatch="include" />
    </RuleGroup>

  </EventFiltering>
</Sysmon>
